# clearsky configuration. Copy to `.env` (git-ignored). Real env vars override these.
# All variables are optional — sensible defaults are baked in for Donvale, VIC.

# --- Server ---
CLEARSKY_ADDR=:8994
CLEARSKY_DB=clearsky.db
CLEARSKY_BASE_URL=http://localhost:8080
CLEARSKY_LOG_LEVEL=info          # debug | info | warn | error

# --- Site + schedule ---
CLEARSKY_TZ=Australia/Melbourne
CLEARSKY_RUN_HOUR=18             # daily check fires at this local time
CLEARSKY_RUN_MINUTE=0
CLEARSKY_LAT=-37.79              # Donvale
CLEARSKY_LON=145.18
CLEARSKY_CATCHUP_ON_START=true   # on boot, run today's check if it hasn't run yet

# --- Retry (a failed check is retried, not skipped to tomorrow) ---
# The job hits the forecast APIs at one fixed instant every day, so a provider that is
# reliably unavailable at that instant costs EVERY night. Aug 2026: Open-Meteo returned
# 503 to all three models at exactly 08:00 UTC (= 18:00 Melbourne) and four consecutive
# nights recorded nothing at all. Retries back off and stop at RETRY_UNTIL_HOUR; if the
# deadline passes with no success, a failure alert goes to the notification channels.
CLEARSKY_RETRY_FIRST=2m          # wait before the first retry (bare number = minutes)
CLEARSKY_RETRY_MAX=30m           # ceiling on the doubling backoff
CLEARSKY_RETRY_UNTIL_HOUR=23     # stop retrying at this local hour

# --- Weather source ---
# agreement = ECMWF, GFS and ICON must ALL be clear (most conservative, default).
#   Three models from three separate met centres, fetched by name through Open-Meteo.
#   Independence is the point: the old pairing (Open-Meteo best_match + yr.no) turned
#   out to be the same model twice and agreed within ~4% on every hour, so requiring
#   "both" to be clear filtered nothing.
# ecmwf / gfs / icon = one named model on its own.
# open-meteo = Open-Meteo's best_match blend. met-no = yr.no. Both kept for comparison;
#   neither is independent of ecmwf, so don't build an agreement set out of them.
CLEARSKY_SOURCE=agreement
# MET Norway (yr.no) REQUIRES a descriptive User-Agent with contact info.
# Only consulted when CLEARSKY_SOURCE=met-no.
CLEARSKY_METNO_USER_AGENT=clearsky-astro/1.0 (+https://deepspaceplace.com)

# --- Visual "Tonight" panel images (eyeball check; not used by the decision) ---
# Defaults are derived for Donvale/Melbourne. Override if you move.
#CLEARSKY_CLEAROUTSIDE_IMG=https://clearoutside.com/forecast_image_large/-37.79/145.18/forecast.png
#CLEARSKY_YR_METEOGRAM=https://www.yr.no/en/content/2-2158177/meteogram.svg
#CLEARSKY_SKIPPY_IMG=https://www.skippysky.com.au/Melbourne/cloud_total/melb_006_cct.png
#CLEARSKY_DEEPSPACE_URL=https://deepspaceplace.com/weather

# --- Decision thresholds (moon is info-only and never gates the decision) ---
# The night is judged on its longest contiguous run of imageable hours ("the usable
# window"), not on whole-night aggregates. The cloud caps below are applied PER HOUR
# to decide which hours qualify; CLOUD_AVG_MAX_PCT then applies to the resulting run.
CLEARSKY_MIN_USABLE_HOURS=3      # shortest usable window worth a GO
CLEARSKY_CLOUD_MAX_PCT=40        # per-hour total cloud cap
CLEARSKY_CLOUD_LOW_MAX_PCT=30    # per-hour low cloud cap (low cloud blocks the most)
CLEARSKY_CLOUD_MID_MAX_PCT=30    # per-hour mid cloud cap
CLEARSKY_CLOUD_AVG_MAX_PCT=25    # mean cloud over the usable window must be <= this
CLEARSKY_RAIN_MM_VETO_HOUR=0.0   # measurable rain in an hour -> that hour is unusable
CLEARSKY_RAIN_PROB_VETO_PCT=35   # per-hour rain probability above this -> unusable
CLEARSKY_RAIN_MM_TOTAL_VETO=0.2  # precip totalled over the usable window -> NO-GO
CLEARSKY_RAIN_MARGIN_HOURS=2     # rain this soon after the window -> "pack up by" note
CLEARSKY_VIS_MIN_M=20000         # below this, a haze note is added (no veto)

# --- Notifications (GO nights, plus any night the check fails outright). ---
# Leave blank to disable a channel.
CLEARSKY_DISCORD_WEBHOOK_URL=
# Gmail: create an App Password (needs 2FA) and use it here, not your login password.
CLEARSKY_SMTP_HOST=smtp.gmail.com
CLEARSKY_SMTP_PORT=587
CLEARSKY_SMTP_USER=
CLEARSKY_SMTP_PASS=
CLEARSKY_EMAIL_TO=
